# Scan jobs in their own Python 3.12 environment (src.jev_scan, src.rerank_scan). Upload with chtc/upload.sh, then from the project folder on
# the access point:
#
#   condor_submit GPU='H200$' LENGTH=short chtc/jev_rerank_scan.sub
#
# Keep comments on their own lines: condor_submit treats a trailing # as part
# of the value.

if !defined MODULE
  MODULE = jev_scan
endif
# rerank_scan takes MODEL = bge or minilm; - means none.
if !defined MODEL
  MODEL = -
endif
if !defined DATASET
  DATASET = 20newsgroups
endif
if !defined SIZES
  SIZES = 1000
endif
if !defined TAG
  TAG = jev9b
endif
# 0 runs every query in the dataset. NFCorpus comparisons use the first 50.
if !defined MAX_QUERIES
  MAX_QUERIES = 0
endif
if !defined LENGTH
  LENGTH = short
endif
if !defined GPU
  GPU = H200$
endif

universe                = container
container_image         = docker://python:3.12-bookworm
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT

executable              = chtc/run_jev_rerank_scan.sh
arguments               = $(MODULE) $(DATASET) $(SIZES) $(TAG) $(MAX_QUERIES) $(MODEL)

transfer_input_files    = src, data, chtc/run_jev_rerank_scan.sh
transfer_output_files   = results

log                     = logs/$(Cluster)_$(Process).log
error                   = logs/$(Cluster)_$(Process).err
output                  = logs/$(Cluster)_$(Process).out

request_cpus            = 4
request_memory          = 64GB
request_disk            = 80GB
request_gpus            = 1

requirements = (Target.CUDADriverVersion >= 12.8) && \
               (Target.GPUs_GlobalMemoryMb >= 40000) && \
               (Target.GPUs_Capability >= 8.0) && (Target.GPUs_Capability <= 9.0) && \
               !regexp("MIG", Target.GPUs_DeviceName) && \
               regexp("$(GPU)", Target.GPUs_DeviceName)

+WantGPULab             = true
+WantFlocking           = false
+WantGlidein            = false
+GPUJobLength           = "$(LENGTH)"

queue 1
