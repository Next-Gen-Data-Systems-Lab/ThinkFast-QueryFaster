# The main comparison: scan, ANN, hybrid and the search agent with Qwen on vLLM
# (src.runner), on CHTC. Upload with chtc/upload.sh, then from the project folder on
# the access point:
#
#   condor_submit chtc/scan_vs_agent.sub
#
# Short test job, with its own output file:
#
#   condor_submit SIZES=1000 BATCHES=32,256 TAG=test chtc/scan_vs_agent.sub
#
# Search agent only (it runs queries one at a time, so one batch size is enough):
#
#   condor_submit ARMS=agent BATCHES=32 TAG=agent chtc/scan_vs_agent.sub
#
# Batched agent, sweeping queries in flight (BATCHES must cover the largest):
#
#   condor_submit ARMS=agent BATCHES=64 AGENT_CONCURRENCY=1,4,16 TAG=c chtc/scan_vs_agent.sub
#
# Keep comments on their own lines: condor_submit treats a trailing # as part
# of the value.

if !defined DATASET
  DATASET = 20newsgroups
endif
if !defined MODEL
  MODEL = Qwen/Qwen2.5-7B-Instruct
endif
if !defined SIZES
  SIZES = 1000,5000,10000
endif
if !defined BATCHES
  BATCHES = 32,64,128,256
endif
if !defined K
  K = 100
endif
if !defined TAG
  TAG = midterm
endif
if !defined ARMS
  ARMS = classify,ann,hybrid
endif
# 0 runs every query in the dataset.
if !defined MAX_QUERIES
  MAX_QUERIES = 0
endif
# CHTC limits: short = 12 hours, medium = 24 hours, long = 7 days and 4 GPUs.
if !defined LENGTH
  LENGTH = long
endif
if !defined AGENT_STEPS
  AGENT_STEPS = 8
endif
# Queries in flight for the agent arm; none runs them one at a time.
if !defined AGENT_CONCURRENCY
  AGENT_CONCURRENCY = none
endif
# Documents are cut to this many characters.
if !defined MAX_CHARS
  MAX_CHARS = 2000
endif
# Runs each agent query this many times, to go past the number of queries.
if !defined AGENT_REPLICAS
  AGENT_REPLICAS = 1
endif
# semantic, or semantic,keyword to give the agent BM25 search as well.
# Larger models need more: Qwen2.5-32B weights alone are about 65 GB.
if !defined MEMORY
  MEMORY = 48GB
endif
if !defined DISK
  DISK = 80GB
endif
if !defined AGENT_TOOLS
  AGENT_TOOLS = semantic
endif
if !defined AGENT_STOP
  AGENT_STOP = agent
endif
# Regular expression on the device name, e.g. GPU=H200 to keep runs comparable.
if !defined GPU
  GPU = A100|H200
endif

universe                = container
container_image         = docker://vllm/vllm-openai:v0.6.3
# The image's entrypoint is the vLLM API server. Without this, run_scan_vs_agent.sh is passed
# to that server as an argument and never runs.
docker_override_entrypoint = true
should_transfer_files   = YES
# Keeps partial results if the job is evicted, so the runner can resume.
when_to_transfer_output = ON_EXIT_OR_EVICT

executable              = chtc/run_scan_vs_agent.sh
arguments               = $(DATASET) $(MODEL) $(SIZES) $(BATCHES) $(K) $(TAG) $(ARMS) $(MAX_QUERIES) $(AGENT_STEPS) $(AGENT_CONCURRENCY) $(MAX_CHARS) $(AGENT_REPLICAS) $(AGENT_TOOLS) $(AGENT_STOP)

transfer_input_files    = src, data, chtc/run_scan_vs_agent.sh, requirements.txt
transfer_output_files   = results, figs

log                     = logs/$(Cluster)_$(Process).log
error                   = logs/$(Cluster)_$(Process).err
output                  = logs/$(Cluster)_$(Process).out

# ---- resources ----------------------------------------------------------
request_cpus            = 4
request_memory          = $(MEMORY)
request_disk            = $(DISK)
request_gpus            = 1

# A100 (40/80GB) or H200. A 7B model in bf16 needs ~15GB of weights; the rest
# is KV cache, which is what lets max_num_seqs go high -- and batch size is
# the variable this project is about, so ask for the big card.
#
# Capability bounds: bf16 needs 8.0+, and vLLM 0.6.3 predates anything past
# 9.0. MIG slices are excluded because they are only part of a GPU. The image
# is built on CUDA 12.1.
requirements = (Target.CUDADriverVersion >= 12.1) && \
               (Target.GPUs_GlobalMemoryMb >= 40000) && \
               (Target.GPUs_Capability >= 8.0) && (Target.GPUs_Capability <= 9.0) && \
               !regexp("MIG", Target.GPUs_DeviceName) && \
               regexp("$(GPU)", Target.GPUs_DeviceName)

+WantGPULab             = true
+WantFlocking           = false
+WantGlidein            = false
+GPUJobLength           = "$(LENGTH)"

queue 1
